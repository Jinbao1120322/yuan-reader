{
  "expo": {
    "name": "源阅读",
    "slug": "yuan-reader",
    "version": "1.0.37",
    "orientation": "portrait",
    "scheme": "yuanreader",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yuan.reader",
      "buildNumber": "38",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.yuan.reader",
      "versionCode": 37
    },
    "web": {
      "bundler": "metro"
    }
  }
}
